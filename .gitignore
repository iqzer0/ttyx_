# Build outputs
/ttyx
ttyx-test-*
__test__library__
.dub
*.o
*.obj
docs.json
__dummy.html

# install.sh intermediates (gresource, localized desktop/appdata, transient .mo)
/build/

# gettext template — generated by extract-strings.sh, deliberately not tracked
# (the stale Tilix-branded po/tilix.pot was removed in 5d00c605 for this
# reason). Ignored so a local extractor run cannot be committed by accident.
po/*.pot

# Generated at run time by debug-ttyx.sh (runs as your user, not root)
data/gsettings/gschemas.compiled
data/man/man

# NOTE: install.sh used to generate into the source tree — the entries for
# data/pkg/desktop/*.desktop, data/metainfo/*.appdata.xml and
# data/resources/ttyx.gresource are gone because it now writes to /build/.
# If an older `sudo ./install.sh` left root-owned copies of those behind, they
# will now show up as untracked; that is deliberate, so you notice and delete
# them (they break subsequent non-root builds).

# Local dev
.rundata/
.vscode
*~
