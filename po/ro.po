msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:126
msgid "Security: per-paste unsafe warning (no longer permanently dismissed)"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:127
