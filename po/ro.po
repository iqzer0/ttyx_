"Security: all options consolidated in Advanced preferences with descriptions"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:128
msgid "Flatpak packaging with GNOME 48 SDK and bundled LDC compiler"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:129
msgid "ProcessMonitor optimization: idle CPU reduced from 1.4% to 0.1%"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:133
msgid "Fix GC crash when opening preferences on GLib 2.84+"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:134
