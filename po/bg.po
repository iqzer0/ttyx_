#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:5
#: data/pkg/desktop/io.github.gwelr.ttyx.desktop.in:4
msgid "A tiling terminal for Linux, forked from Tilix"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:9
msgid ""
"ttyx_ is an actively maintained fork of Tilix, the tiling terminal emulator."
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:12
msgid "It lets you:"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:14
#, fuzzy
msgid ""
"Layout terminals in any fashion by splitting them horizontally or vertically"
msgstr ""
"Разпределение на терминалите по всякакъв начин като ги разделяте "
"хоризонтално или вертикално"

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:15
msgid ""
"Terminals can be re-arranged using drag and drop both within and between "
"windows"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:16
msgid "Terminals can be detached into a new window via drag and drop"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:17
#, fuzzy
msgid ""
"Input can be synchronized between terminals so commands typed in one "
"terminal are replicated to the others"
msgstr ""
"Входа може да се синхронизира между терминалите като командите въвеждани в "
"един терминал се повтарят в останалите"

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:18
msgid "The grouping of terminals can be saved and loaded from disk"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:19
#, fuzzy
msgid "Terminals support custom titles"
msgstr "Заглавие на терминала"

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:20
msgid ""
"Color schemes are stored in files and custom color schemes can be created by "
"simply creating a new file"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:21
msgid "Transparent background"
msgstr "Прозрачен фон"

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:22
#, fuzzy
msgid "Supports notifications when processes are completed out of view"
msgstr "Изпратете уведомяване на десктопа когато процеса завърши"

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:42
#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:70
#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:92
#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:116
msgid "This release adds the following features:"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:44
msgid ""
"OSC 11 dynamic background color — apps like neovim and theme-switching "
"scripts can now change the terminal background at runtime via the OSC 11 "
"escape sequence; reset with OSC 111"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:45
msgid ""
"enable-wide-handle defaults to true so the splitter between split terminals "
"is easier to see and grab on dark themes and HiDPI displays"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:46
msgid "Auto-equalize panes on split and close, sway-style"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:47
msgid "Documentation site at https://gwelr.github.io/ttyx_/"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:48
msgid ""
"Sensitive values redaction: passwords, tokens and proxy credentials are "
"stripped from trace logs, command-line argv and hyperlink click events "
"before reaching any log sink"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:50
#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:82
#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:98
#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:131
msgid "This release fixes the following bugs:"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:52
msgid ""
"Maximized terminal now correctly restores when loading a saved session; "
"fixes a long-standing bug pre-existing since the upstream Tilix 2017 "
"implementation"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:53
msgid ""
"Trigger templates: $0 now correctly substitutes the whole match (was shifted "
"by one due to a size_t underflow); user templates relying on the bugged "
"behaviour need indices shifted up by one"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:54
msgid ""
"Triggers with an unrecognised action name are now skipped with a warning "
"instead of silently rewritten to UpdateState"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:55
msgid ""
"Paste hardening: strip OSC, DCS, APC and PM escape sequences from clipboard "
"content before paste"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:56
msgid "Robust /proc/[pid]/stat parser with bounds validation"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:57
msgid ""
"Password manager delete now correctly reports keyring failures and handles "
"legacy Tilix-schema entries"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:58
msgid ""
"Proxy URL builder: percent-encode userinfo and drop the redundant leading @; "
"HTTPS proxy now receives credentials when configured"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:60
#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:104
#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:137
msgid "This release includes the following changes:"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:62
msgid "First beta of the 1.2.0 release; validation period before GA"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:63
msgid ""
"Internal refactors using D SumType for compile-time exhaustiveness: "
"TerminalRegex (BuiltinRegex/CustomRegex), SyncInputEvent, and a typed "
"TerminalSnapshot struct as the single source of truth for session "
"serialisation"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:64
msgid ""
"CI: install LDC from the upstream tarball; build GtkD from source on Debian "
"Testing where the apt package was removed"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:72
msgid ""
"Security: restored sessions now ask for confirmation before running an "
"embedded per-terminal command, instead of executing it silently on load"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:73
msgid ""
"Security: custom-link and trigger commands shell-quote all substituted match "
"tokens and terminal variables, closing a shell-injection hole in values "
"drawn from terminal output or remote-settable OSC variables"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:74
msgid ""
"Security: paste sanitization is now applied on every paste path; the default "
"path previously fell through to pasting the raw clipboard text"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:75
msgid ""
"Security: bracketed-paste escape stripping loops to a fixed point so split "
"or overlapping markers cannot reassemble after removal"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:76
msgid ""
"Security: carriage return now counts as a command submitter in the paste "
"safety checks, matching newline handling"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:77
msgid ""
"Security: OSC 8 hyperlinks are restricted to an allow-listed set of URI "
"schemes before being handed to the desktop URI handler"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:78
msgid ""
"Security: trigger regex matching input is bounded as defense-in-depth "
"against catastrophic-backtracking UI hangs on adversarial output"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:79
msgid ""
"Security: spawn-failure logs redact proxy credentials; log redaction covers "
"more sensitive key names and strips URL userinfo from all values"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:80
msgid "Security: retrieved keyring passwords are kept in non-pageable memory"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:84
msgid "Crash reading the host shell from a malformed passwd entry (Flatpak)"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:85
msgid "Crash loading a session file with a corrupt paned orientation value"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:86
msgid "Crash reading a child process name from a malformed /proc stat entry"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:94
msgid ""
"Automatic config migration from Tilix — on first run, ~/.config/tilix/ is "
"copied to ~/.config/ttyx/ with the original kept as backup"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:95
msgid ""
"Password manager reads legacy com.gexperts.tilix.Password schema for "
"backwards compatibility; new passwords are saved under the ttyx schema"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:96
msgid ""
"TTYX_ID environment variable set in shells alongside TILIX_ID for backwards "
"compatibility with existing shell integrations"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:100
msgid ""
"Color scheme loader no longer shows duplicates; user config now wins over "
"system defaults when a scheme filename exists in both"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:101
msgid ""
"Post-install script writes a minimal index.theme at the install prefix so "
"gtk-update-icon-cache can generate a valid icon cache"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:102
msgid "AppStream metadata no longer includes stale Tilix release entries"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:106
msgid ""
"Rename user-visible Tilix references: Nautilus menu, shortcuts window, "
"GSettings descriptions, icon filenames, log and temp paths"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:107
msgid ""
"Rewrite man page under ttyx_ identity; drop 30 stale translations that "
"referenced Tilix-branded msgids"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:108
msgid ""
"Release process simplified: drop hand-assembled binary tarball, ship only "
"Flatpak bundle with signed checksums"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:109
msgid "Add Troubleshooting section to README (stale icon cache, Wayland Quake)"
msgstr ""

#: data/metainfo/io.github.gwelr.ttyx.appdata.xml.rel.in:110
msgid "Add ROADMAP.md documenting vision and phase plan"
msgstr ""

